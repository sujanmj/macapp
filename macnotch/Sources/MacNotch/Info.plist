<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>MacNotch</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>MacNotch</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Control playback and read track information from Music or Spotify only when you choose Connect.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>MacNotch records your primary display to a movie saved locally in Movies/MacNotch Recordings. Recording starts only when you press Start Recording.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MacNotch adds your microphone to a screen recording only when you enable Include microphone and start recording.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
